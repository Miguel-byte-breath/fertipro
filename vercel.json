{
  "rewrites": [
    {
      "source": "/v1/sativum/crop-units\\:group-crop-units",
      "destination": "/api/sativum-group"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    }
  ],
  "functions": {
    "api/**/*.js": {
      "memory": 1024,
      "maxDuration": 30
    }
  }
}
