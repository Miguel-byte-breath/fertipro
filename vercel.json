{
  "rewrites": [
    {
      "source": "/v1/sativum/fertilization-plans\\:calculate-npk",
      "destination": "/api/sativum-plan"
    },
    {
      "source": "/v1/sativum/crop-units\\:group-crop-units",
      "destination": "/api/sativum-group"
    },
    {
      "source": "/v1/sativum/fertilization-plans\\:export-report",
      "destination": "/api/sativum-report"
    },
    {
      "source": "/api/sigpac-bbox",
      "destination": "/api/sigpac?__action=bbox"
    },
    {
      "source": "/api/sigpac-mvt",
      "destination": "/api/sigpac?__action=mvt"
    },
    {
      "source": "/api/sigpac-recinfo",
      "destination": "/api/sigpac?__action=recinfo"
    },
    {
      "source": "/api/sigpac-zvn",
      "destination": "/api/sigpac?__action=zvn"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    }
  ],
  "functions": {
    "api/**/*.js": {
      "memory": 1024,
      "maxDuration": 30
    }
  }
}
